use dioxus::prelude::*;
use crate::pages::{
    home::Home, about::About, projects::Projects, skills::Skills,
    contact::Contact, todo::TodoPage, pomodoro::Pomodoro, markdown::MarkdownEditor
};
use crate::hooks::use_theme::{use_theme_provider, use_apply_theme};

#[component]
pub fn App() -> Element {
    use_theme_provider();
    use_apply_theme();

    rsx! {
        Router::<Route> {}
    }
}

#[derive(Routable, Clone, PartialEq)]
pub enum Route {
    #[layout(MainLayout)]
        #[route("/")]
        Home {},
        #[route("/about")]
        About {},
        #[route("/projects")]
        Projects {},
        #[route("/skills")]
        Skills {},
        #[route("/contact")]
        Contact {},
        #[route("/todo")]
        TodoPage {},
        #[route("/pomodoro")]
        Pomodoro {},
        #[route("/markdown")]
        MarkdownEditor {},
}

#[component]
fn MainLayout() -> Element {
    let mut mobile_menu_open = use_signal(|| false);

    let toggle_menu = move |_| {
        mobile_menu_open.toggle();
    };

    let close_menu = move |_| {
        mobile_menu_open.set(false);
    };

    rsx! {
        div { class: "min-h-screen bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors",
            nav { class: "sticky top-0 z-50 h-16 border-b border-gray-200 dark:border-gray-800 flex items-center px-8 bg-white/80 dark:bg-gray-900/80 backdrop-blur-md",
                div { class: "max-w-7xl mx-auto w-full flex items-center justify-between",
                    Link { to: Route::Home {}, class: "text-xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent", "Abolfazl Ghorbani" }

                    div { class: "hidden lg:flex gap-4",
                        Link { to: Route::Home {}, class: "text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium text-sm", "Home" }
                        Link { to: Route::About {}, class: "text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium text-sm", "About" }
                        Link { to: Route::Projects {}, class: "text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium text-sm", "Projects" }
                        Link { to: Route::Skills {}, class: "text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium text-sm", "Skills" }
                        Link { to: Route::TodoPage {}, class: "text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium text-sm", "Todo" }
                        Link { to: Route::Pomodoro {}, class: "text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium text-sm", "Pomodoro" }
                        Link { to: Route::MarkdownEditor {}, class: "text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium text-sm", "Markdown" }
                        Link { to: Route::Contact {}, class: "text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium text-sm", "Contact" }
                    }

                    button {
                        class: "lg:hidden flex flex-col justify-center items-center w-10 h-10 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors",
                        onclick: toggle_menu,
                        aria_label: "Toggle menu",
                        div { class: "relative w-6 h-6",
                            div { class: "absolute h-0.5 w-6 bg-gray-700 dark:bg-gray-300 transition-all duration-300 {if mobile_menu_open() { \"top-3 rotate-45\" } else { \"top-1\" }}" }
                            div { class: "absolute top-3 h-0.5 w-6 bg-gray-700 dark:bg-gray-300 transition-all duration-300 {if mobile_menu_open() { \"opacity-0\" } else { \"opacity-100\" }}" }
                            div { class: "absolute h-0.5 w-6 bg-gray-700 dark:bg-gray-300 transition-all duration-300 {if mobile_menu_open() { \"top-3 -rotate-45\" } else { \"top-5\" }}" }
                        }
                    }
                }
            }

            if mobile_menu_open() {
                div {
                    class: "lg:hidden fixed inset-0 z-40 bg-black/50 backdrop-blur-sm animate-fade-in",
                    onclick: close_menu,
                }
            }

            if mobile_menu_open() {
                div {
                    class: "lg:hidden fixed top-16 left-0 right-0 z-50 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 shadow-lg animate-slide-down",
                    div { class: "flex flex-col py-4",
                        Link { to: Route::Home {}, class: "flex items-center gap-3 px-8 py-4 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-blue-600 dark:hover:text-blue-400 transition-colors", onclick: close_menu,
                            span { class: "text-2xl", "🏠" }
                            span { class: "font-medium", "Home" }
                        }
                        Link { to: Route::About {}, class: "flex items-center gap-3 px-8 py-4 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-blue-600 dark:hover:text-blue-400 transition-colors", onclick: close_menu,
                            span { class: "text-2xl", "👤" }
                            span { class: "font-medium", "About" }
                        }
                        Link { to: Route::Projects {}, class: "flex items-center gap-3 px-8 py-4 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-blue-600 dark:hover:text-blue-400 transition-colors", onclick: close_menu,
                            span { class: "text-2xl", "💼" }
                            span { class: "font-medium", "Projects" }
                        }
                        Link { to: Route::Skills {}, class: "flex items-center gap-3 px-8 py-4 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-blue-600 dark:hover:text-blue-400 transition-colors", onclick: close_menu,
                            span { class: "text-2xl", "⚡" }
                            span { class: "font-medium", "Skills" }
                        }
                        Link { to: Route::TodoPage {}, class: "flex items-center gap-3 px-8 py-4 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-blue-600 dark:hover:text-blue-400 transition-colors", onclick: close_menu,
                            span { class: "text-2xl", "✅" }
                            span { class: "font-medium", "Todo" }
                        }
                        Link { to: Route::Pomodoro {}, class: "flex items-center gap-3 px-8 py-4 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-blue-600 dark:hover:text-blue-400 transition-colors", onclick: close_menu,
                            span { class: "text-2xl", "⏱️" }
                            span { class: "font-medium", "Pomodoro" }
                        }
                        Link { to: Route::MarkdownEditor {}, class: "flex items-center gap-3 px-8 py-4 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-blue-600 dark:hover:text-blue-400 transition-colors", onclick: close_menu,
                            span { class: "text-2xl", "📝" }
                            span { class: "font-medium", "Markdown" }
                        }
                        Link { to: Route::Contact {}, class: "flex items-center gap-3 px-8 py-4 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-blue-600 dark:hover:text-blue-400 transition-colors", onclick: close_menu,
                            span { class: "text-2xl", "📧" }
                            span { class: "font-medium", "Contact" }
                        }
                    }
                }
            }

            main {
                Outlet::<Route> {}
            }

            footer { class: "border-t border-gray-200 dark:border-gray-800 py-8 mt-16",
                div { class: "max-w-7xl mx-auto px-8 text-center",
                    p { class: "text-gray-600 dark:text-gray-400", "© 2026 Abolfazl Ghorbani. Built with Rust & Dioxus." }
                }
            }
        }
    }
}
